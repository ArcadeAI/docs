{
  "name": "arcade-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Arcade Documentation (Fumadocs)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-meta": "bun scripts/check-meta-keys.ts",
    "check-redirects": "bun scripts/check-redirects.ts",
    "dev": "next dev",
    "format": "bunx ultracite fix",
    "postinstall": "fumadocs-mdx",
    "lint": "bunx ultracite check",
    "llmstxt": "tsx scripts/generate-llmstxt.ts",
    "metadata-report": "bun toolkit-docs-generator/scripts/report-tool-metadata.ts",
    "prepare": "husky",
    "start": "next start",
    "sync-crawler-config": "bun scripts/sync-crawler-config.ts",
    "sync-toolkit-sidebar": "tsx toolkit-docs-generator/scripts/sync-toolkit-sidebar.ts",
    "test": "bunx vitest --run",
    "test:external-urls": "bunx vitest run --config vitest.external-urls.config.ts",
    "test:watch": "bunx vitest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p toolkit-docs-generator/tsconfig.json --noEmit",
    "update-links": "bun scripts/update-internal-links.ts",
    "vale": "vale",
    "vale:check": "vale content/docs/",
    "vale:editorial": "bun scripts/vale-editorial.ts",
    "vale:fix": "bun scripts/vale-fix.ts",
    "vale:review": "bun scripts/vale-style-review.ts",
    "vale:sync": "vale sync"
  },
  "lint-staged": {
    "!(examples)/**/*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite fix"
    ]
  },
  "dependencies": {
    "@arcadeai/design-system": "7.11.0",
    "@arcadeai/ui-kit": "0.14.0",
    "@mdx-js/mdx": "3.1.1",
    "@next/third-parties": "16.3.8",
    "@ory/client": "1.22.37",
    "@shikijs/transformers": "4.5.0",
    "@uidotdev/usehooks": "2.4.1",
    "algoliasearch": "5.53.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.15.18",
    "github-slugger": "2.0.0",
    "lucide-react": "0.577.0",
    "mermaid": "11.17.2",
    "motion": "12.40.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "posthog-js": "1.379.0",
    "posthog-node": "5.35.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.77.0",
    "react-instantsearch": "7.34.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "remark-gfm": "4.0.1",
    "swagger-ui-react": "5.32.14",
    "tailwindcss-animate": "1.0.7",
    "unist-util-visit": "5.1.0",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@biomejs/biome": "2.3.2",
    "@octokit/rest": "22.0.1",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/typography": "0.5.19",
    "@types/bun": "1.4.2",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.13",
    "@types/node": "22.19.17",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/unist": "3.0.3",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "fast-glob": "3.3.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "mdast-util-to-string": "4.0.0",
    "next-validate-link": "1.6.6",
    "openai": "6.41.0",
    "ora": "9.4.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.8",
    "typescript": "5.9.3",
    "ultracite": "6.1.0",
    "vite": "7.3.5",
    "vitest": "4.1.8"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "22.x",
    "bun": ">=1.4.0"
  }
}
