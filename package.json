{
  "name": "arcade-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Arcade Documentation (Fumadocs)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-meta": "bun scripts/check-meta-keys.ts",
    "check-redirects": "bun scripts/check-redirects.ts",
    "dev": "next dev",
    "format": "bunx ultracite fix",
    "postinstall": "fumadocs-mdx",
    "lint": "bunx ultracite check",
    "llmstxt": "bun scripts/generate-llmstxt.ts",
    "metadata-report": "bun toolkit-docs-generator/scripts/report-tool-metadata.ts",
    "migrate:content": "bun scripts/migration/migrate-content.ts",
    "prepare": "husky",
    "start": "next start",
    "sync-crawler-config": "bun scripts/sync-crawler-config.ts",
    "sync-toolkit-sidebar": "bun toolkit-docs-generator/scripts/sync-toolkit-sidebar.ts",
    "test": "bunx vitest --run",
    "test:external-urls": "bunx vitest run --config vitest.external-urls.config.ts",
    "test:watch": "bunx vitest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p toolkit-docs-generator/tsconfig.json --noEmit",
    "update-links": "bun scripts/update-internal-links.ts",
    "vale": "vale",
    "vale:check": "vale content/docs/",
    "vale:editorial": "bun scripts/vale-editorial.ts",
    "vale:fix": "bun scripts/vale-fix.ts",
    "vale:review": "bun scripts/vale-style-review.ts",
    "vale:sync": "vale sync",
    "verify:content": "bun scripts/migration/verify-content.ts"
  },
  "lint-staged": {
    "!(examples)/**/*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite fix"
    ]
  },
  "dependencies": {
    "@arcadeai/design-system": "7.11.0",
    "@arcadeai/ui-kit": "0.21.0",
    "@mdx-js/mdx": "3.1.1",
    "@next/third-parties": "16.3.8",
    "@ory/client": "1.22.66",
    "@shikijs/transformers": "4.5.0",
    "@uidotdev/usehooks": "2.4.1",
    "algoliasearch": "5.59.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.15.18",
    "lucide-react": "1.51.0",
    "mermaid": "12.1.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "posthog-js": "1.435.8",
    "posthog-node": "5.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "remark-gfm": "4.0.1",
    "swagger-ui-react": "5.33.1",
    "tailwindcss-animate": "1.0.7",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@biomejs/biome": "2.5.15",
    "@octokit/rest": "22.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/bun": "1.4.2",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/unist": "3.0.3",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "dotenv": "18.0.5",
    "fast-glob": "3.3.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mdast-util-to-string": "4.0.0",
    "next-validate-link": "1.6.7",
    "openai": "7.27.0",
    "ora": "9.4.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  }
}
