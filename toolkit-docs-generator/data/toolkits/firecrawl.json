    {
      "name": "ExtractData",
      "qualifiedName": "Firecrawl.ExtractData",
      "fullyQualifiedName": "Firecrawl.ExtractData@4.0.0",
      "description": "Collect structured records from the web from a plain-language description.\n\nUse this when the answer is fields such as products, prices, or contacts.\nUse ScrapeUrl or CrawlWebsite when the answer is the page text itself. An\nextraction that outruns wait_seconds keeps running, and GetExtractStatus\ntakes its job_id.",
      "parameters": [
        {
          "name": "prompt",
          "type": "string",
          "required": true,
          "description": "The data to collect, in plain language, such as every product name and its price.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "urls",
          "type": "array",
          "innerType": "string",
          "required": false,
          "description": "Pages to start from. Defaults to letting Firecrawl find its own sources.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "model",
          "type": "string",
          "required": false,
          "description": "Which model collects the data. Defaults to the fastest and cheapest one; move up only for a site that needs more reasoning.",
          "enum": [
            "spark-1-mini",
            "spark-1-pro",
            "spark-2"
          ],
          "inferrable": true
        },
        {
          "name": "effort",
          "type": "string",
          "required": false,
          "description": "How hard the model should work. Higher effort costs more and takes longer. Defaults to the model's own setting.",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "inferrable": true
        },
        {
          "name": "wait_seconds",
          "type": "integer",
          "required": false,
          "description": "How long to wait before handing back a job id, from 5 to 25 seconds. Defaults to 25.",
          "enum": null,
          "inferrable": true
        }
      ],
      "auth": null,
      "secrets": [
        "FIRECRAWL_API_KEY"
      ],
      "secretsInfo": [
        {
          "name": "FIRECRAWL_API_KEY",
          "type": "api_key"
        }
      ],
      "output": {
        "type": "json",
        "description": "The extracted data, or a job id if still running"
      },
      "documentationChunks": [],
      "codeExample": {
        "toolName": "Firecrawl.ExtractData",
        "parameters": {
          "prompt": {
            "value": "Extract every product name, price, and availability status from the page.",
            "type": "string",
            "required": true
          },
          "urls": {
            "value": [
              "https://example-store.com/products",
              "https://example-store.com/sale"
            ],
            "type": "array",
            "required": false
          },
          "model": {
            "value": "gpt-4o",
            "type": "string",
            "required": false
          },
          "effort": {
            "value": "high",
            "type": "string",
            "required": false
          },
          "wait_seconds": {
            "value": 20,
            "type": "integer",
            "required": false
          }
        },
        "requiresAuth": false,
        "tabLabel": "Call the Tool"
      },
