    {
      "name": "CrawlWebsite",
      "qualifiedName": "Firecrawl.CrawlWebsite",
      "fullyQualifiedName": "Firecrawl.CrawlWebsite@4.0.0",
      "description": "Read many pages of one website and return each page's content.\n\nA crawl that outruns wait_seconds keeps running: the result carries its\njob_id, and GetCrawlStatus, GetCrawlData, and CancelCrawl take it from there.",
      "parameters": [
        {
          "name": "url",
          "type": "string",
          "required": true,
          "description": "Absolute http(s) URL to start the crawl from.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "description": "How many pages to read at most, from 1 to 100. Defaults to 10.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "max_discovery_depth",
          "type": "integer",
          "required": false,
          "description": "How many links deep to follow from the starting URL. Defaults to Firecrawl's own depth.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "sitemap",
          "type": "string",
          "required": false,
          "description": "How to use the site's own sitemap when finding pages. Defaults to including it alongside discovered links.",
          "enum": [
            "include",
            "skip",
            "only"
          ],
          "inferrable": true
        },
        {
          "name": "wait_seconds",
          "type": "integer",
          "required": false,
          "description": "How long to wait for the crawl before handing back a job id, from 5 to 25 seconds. Defaults to 25.",
          "enum": null,
          "inferrable": true
        }
      ],
      "auth": null,
      "secrets": [
        "FIRECRAWL_API_KEY"
      ],
      "secretsInfo": [
        {
          "name": "FIRECRAWL_API_KEY",
          "type": "api_key"
        }
      ],
      "output": {
        "type": "json",
        "description": "Page content from the crawl, or a job id if still running"
      },
      "documentationChunks": [],
      "codeExample": {
        "toolName": "Firecrawl.CrawlWebsite",
        "parameters": {
          "url": {
            "value": "https://www.example.com",
            "type": "string",
            "required": true
          },
          "limit": {
            "value": 25,
            "type": "integer",
            "required": false
          },
          "max_discovery_depth": {
            "value": 3,
            "type": "integer",
            "required": false
          },
          "sitemap": {
            "value": "include",
            "type": "string",
            "required": false
          },
          "wait_seconds": {
            "value": 15,
            "type": "integer",
            "required": false
          }
        },
        "requiresAuth": false,
        "tabLabel": "Call the Tool"
      },
      "metadata": {
        "classification": {
          "serviceDomains": [
            "web_scraping"
          ]
