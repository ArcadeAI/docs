    {
      "name": "SearchDeveloperDocs",
      "qualifiedName": "Firecrawl.SearchDeveloperDocs",
      "fullyQualifiedName": "Firecrawl.SearchDeveloperDocs@4.0.0",
      "description": "Search developer documentation and repositories, quoting the text that matched.\n\nUse this to answer a question about how a library or API works. Use Search\nfor the open web, and SearchGithubIssues to look only at issues.",
      "parameters": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "What to look for across documentation, READMEs, issues, and PRs.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "k",
          "type": "integer",
          "required": false,
          "description": "How many results to return, from 1 to 25. Defaults to 8.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "passages",
          "type": "integer",
          "required": false,
