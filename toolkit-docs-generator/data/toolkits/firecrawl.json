    {
      "name": "Search",
      "qualifiedName": "Firecrawl.Search",
      "fullyQualifiedName": "Firecrawl.Search@4.0.0",
      "description": "Search the web and optionally read each result page in the same call.\n\nUse this when no URL is known yet. Use SearchResearchPapers for scientific\nliterature and SearchDeveloperDocs for API and code documentation.",
      "parameters": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "What to search the web for.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "description": "How many results to return, from 1 to 20. Defaults to 5.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "sources",
          "type": "array",
          "innerType": "string",
          "required": false,
          "description": "Which families of results to search. Defaults to web pages only.",
          "enum": [
            "web",
            "news",
            "images"
          ],
          "inferrable": true
        },
        {
          "name": "categories",
          "type": "array",
          "innerType": "string",
          "required": false,
          "description": "Narrow the results to one kind of source. The developer category cannot be combined with the others. Defaults to no narrowing.",
          "enum": [
            "github",
            "research",
            "pdf",
            "developer"
          ],
          "inferrable": true
        },
        {
          "name": "scrape_content",
          "type": "boolean",
          "required": false,
          "description": "Also read each result page, so one call returns content rather than just links. Defaults to true.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "location",
          "type": "string",
          "required": false,
          "description": "Bias results toward a place, written as 'City, Region, Country'. Defaults to no location bias.",
