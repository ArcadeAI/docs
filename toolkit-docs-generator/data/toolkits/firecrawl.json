    {
      "name": "ScrapeUrl",
      "qualifiedName": "Firecrawl.ScrapeUrl",
      "fullyQualifiedName": "Firecrawl.ScrapeUrl@4.0.0",
      "description": "Read one web page whose URL is already known and return its content.\n\nUse Search instead when the URL is unknown, MapWebsite to list a site's\nURLs, CrawlWebsite to read many pages of one site, and ExtractData to pull\nstructured fields rather than page text.",
      "parameters": [
        {
          "name": "url",
          "type": "string",
          "required": true,
          "description": "Absolute http(s) URL of the page to read.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "formats",
          "type": "array",
          "innerType": "string",
          "required": false,
          "description": "Content formats to return. Defaults to markdown only.",
          "enum": [
            "markdown",
            "html",
            "rawHtml",
            "links",
            "screenshot",
            "summary"
          ],
          "inferrable": true
        },
        {
          "name": "only_main_content",
          "type": "boolean",
          "required": false,
          "description": "Drop navigation, sidebars, and footers, keeping the page's main content. Defaults to true.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "proxy",
          "type": "string",
          "required": false,
          "description": "Route the fetch through a different proxy. Escalate to a slower, harder-to-block proxy for a page that returns a block page or empty content. Defaults to Firecrawl's own choice.",
          "enum": [
            "basic",
            "stealth",
            "enhanced",
            "auto"
          ],
          "inferrable": true
        }
      ],
      "auth": null,
      "secrets": [
        "FIRECRAWL_API_KEY"
      ],
      "secretsInfo": [
        {
          "name": "FIRECRAWL_API_KEY",
          "type": "api_key"
        }
      ],
      "output": {
        "type": "json",
        "description": "The page's content and metadata"
      },
      "documentationChunks": [],
