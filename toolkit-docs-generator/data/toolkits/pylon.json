    {
      "name": "ListIssues",
      "qualifiedName": "Pylon.ListIssues",
      "fullyQualifiedName": "Pylon.ListIssues@3.0.1",
      "description": "List Pylon issues with optional filtering by state, assignee, team, and tags.",
      "parameters": [
        {
          "name": "state",
          "type": "string",
          "required": false,
          "description": "Only include issues in this state. Defaults to all states.",
          "enum": [
            "new",
            "open",
            "waiting_on_customer",
            "waiting_on_you",
            "on_hold",
            "closed",
            "snoozed"
          ],
          "inferrable": true
        },
        {
          "name": "assignee_id",
          "type": "string",
          "required": false,
          "description": "Only include issues assigned to the user with this ID. Defaults to all assignees.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "team_id",
          "type": "string",
          "required": false,
          "description": "Only include issues of the team with this ID. Defaults to all teams.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "tags",
          "type": "array",
          "innerType": "string",
          "required": false,
          "description": "Only include issues that carry every one of these tags. Defaults to any tags.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "start_time",
          "type": "string",
          "required": false,
          "description": "Start of date range in RFC3339 format (YYYY-MM-DDTHH:MM:SSZ). Defaults to 7 days ago.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "end_time",
          "type": "string",
          "required": false,
          "description": "End of date range in RFC3339 format (YYYY-MM-DDTHH:MM:SSZ). Defaults to now.",
          "enum": null,
          "inferrable": true
        },
        {
          "name": "cursor",
          "type": "string",
          "required": false,
          "description": "Pagination cursor from previous response. Defaults to the first page.",
          "enum": null,
          "inferrable": true
        }
      ],
      "auth": null,
      "secrets": [
        "PYLON_API_TOKEN"
      ],
      "secretsInfo": [
        {
          "name": "PYLON_API_TOKEN",
          "type": "token"
        }
      ],
      "output": {
        "type": "json",
        "description": "List of issues matching the filters."
